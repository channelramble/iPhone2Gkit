# ios1kit ramdisk installer. Generated by ios1kit; runs as /etc/profile of the
# single-user shell that launchd starts from the ramdisk (same hook iLiberty used).
# Everything happens here, in one pass: no AFC upload, no second boot from NAND.
#
# How the Mac learns the result: iOS 1 iBoot cannot report NVRAM over USB, so
# the outcome is the boot target. The Mac saves auto-boot=false before booting
# this ramdisk; only the success path below sets auto-boot=true. Success means
# the phone boots iPhone OS. A failure, a crash or a panic means it comes back
# in recovery mode.

PATH="/bin:/sbin:/usr/bin:/usr/sbin"
export PATH

MODE="@MODE@"            # install | repair | probe
RUN_ID="@RUN_ID@"
BATCH="@BATCH@"          # e.g. 1/2
ACTIVATE="@ACTIVATE@"    # 1 = install patched lockdownd
NEED_SYS_KB=@NEED_SYS_KB@
NEED_VAR_KB=@NEED_VAR_KB@
HOLD=@HOLD@              # seconds to keep the final message on screen
R=/mnt1
LOG=""
MOUNTED_SYS=0
MOUNTED_VAR=0

say() {
	echo "$*"
	if [ -n "$LOG" ]; then echo "$*" >> "$LOG"; fi
}

unmount_all() {
	LOG=""
	sync
	if [ $MOUNTED_VAR = 1 ]; then umount "$R/private/var" && MOUNTED_VAR=0; fi
	if [ $MOUNTED_SYS = 1 ]; then umount "$R" && MOUNTED_SYS=0; fi
	sync
	[ $MOUNTED_VAR = 0 ] && [ $MOUNTED_SYS = 0 ]
}

fail() {
	say ""
	say "*** FAILED at step: $1"
	say "*** The phone will restart into RECOVERY mode."
	say "*** Steps after this one were not run."
	nvram ios1kit-result=failed >/dev/null 2>&1
	nvram ios1kit-step="$1" >/dev/null 2>&1
	nvram auto-boot=false >/dev/null 2>&1
	unmount_all
	sleep 60
	reboot
	while true; do sleep 60; done
}

succeed() {
	# Unmount and verify first: auto-boot=true is the "it worked" signal to the Mac.
	unmount_all || fail unmount
	nvram boot-args="" >/dev/null 2>&1 || fail clear-boot-args
	nvram idle-off=true >/dev/null 2>&1 || fail restore-idle-off
	nvram ios1kit-result=success >/dev/null 2>&1 || fail record-success
	nvram auto-boot=true >/dev/null 2>&1 || fail set-auto-boot
	say "$1"
	sleep $HOLD
	reboot
	while true; do sleep 60; done
}

run() {
	# run a command, log its output, fail with $1 as the step name on error
	step="$1"; shift
	"$@" >> "${LOG:-/dev/null}" 2>&1 || fail "$step"
}

fw_version() {
	ver=UNKNOWN
	found=0
	for w in `cat "$R/System/Library/CoreServices/SystemVersion.plist"`; do
		if [ $found = 1 ]; then
			ver=`echo "$w" | cut -d '>' -f 2 | cut -d '<' -f 1`
			break
		fi
		if [ "$w" = "<key>ProductVersion</key>" ]; then found=1; fi
	done
	echo "$ver"
}

free_kb() {
	# prints free KB, or nothing if df did not give a number
	v=`df -k "$1" 2>/dev/null | awk 'NR==2 {print $4}'`
	case "$v" in
		""|*[!0-9]*) ;;
		*) echo "$v" ;;
	esac
}

# Check every embedded archive before mounting or changing the phone's flash.
check_archive() {
    say "Checking ${1##*/}..."
    unzip -t "$1" >/dev/null 2>&1
    rc=$?
    if [ "$rc" -gt 1 ]; then
        unzip -t "$1"
        fail "archive-${1##*/}"
    fi
}

# ---------------------------------------------------------------------------
sleep 3
echo ""
echo "  ios1kit - iPhone OS 1.0 ($MODE, batch $BATCH)"
echo "  Do not unplug the phone."
echo ""

# Never leave the ramdisk boot-args behind: with rd=md0 still saved, a normal
# boot would wait forever for a ramdisk that is no longer in RAM. Stop before
# touching flash if they can't be cleared. (fail keeps auto-boot=false, so
# the phone returns to recovery mode, where `ios1kit kick` clears them.)
nvram boot-args="" >/dev/null 2>&1 || fail clear-boot-args
nvram ios1kit-run-id="$RUN_ID" >/dev/null 2>&1 || fail record-run
nvram ios1kit-result=running >/dev/null 2>&1 || fail record-running

if [ "$MODE" = "probe" ]; then
	# Read-only: nothing on the phone's flash is changed.
	fsck_hfs -n /dev/disk0s1 >/dev/null 2>&1; FS1=$?
	fsck_hfs -n /dev/disk0s2 >/dev/null 2>&1; FS2=$?
	mount_hfs -o rdonly /dev/disk0s1 $R || fail mount-system
	MOUNTED_SYS=1
	mount_hfs -o rdonly /dev/disk0s2 $R/private/var || fail mount-data
	MOUNTED_VAR=1
	SB=ok
	[ -f $R/System/Library/LaunchDaemons/com.apple.SpringBoard.plist ] || SB=MISSING
	LEFT=no
	[ -e $R/bin2 -o -f $R/Library/LaunchDaemons/com.zjlotto.iLiberty.plist -o -f $R/com.apple.SpringBoard.plist ] && LEFT=YES
	ACT=stock
	[ -f $R/usr/libexec/lockdownd.ios1kit-orig ] && ACT=ios1kit
	SYSFREE=`free_kb $R`
	VARFREE=`free_kb $R/private/var`
	echo ""
	echo "  firmware          `fw_version`"
	echo "  system free       ${SYSFREE:-df FAILED} KB"
	echo "  data free         ${VARFREE:-df FAILED} KB"
	echo "  fsck system/data  $FS1 / $FS2   (0 = clean)"
	echo "  SpringBoard plist $SB"
	echo "  iLiberty leftover $LEFT"
	echo "  lockdownd         $ACT"
	echo ""
	succeed "Probe done. Write these down; the phone boots normally next."
fi

@ARCHIVE_CHECKS@

say "Checking file systems..."
fsck_hfs -fy /dev/disk0s1 || fail fsck-system
fsck_hfs -fy /dev/disk0s2 || fail fsck-data
mount_hfs -o noasync,sync /dev/disk0s1 $R || fail mount-system
MOUNTED_SYS=1
mount_hfs -o noasync,sync /dev/disk0s2 $R/private/var || fail mount-data
MOUNTED_VAR=1

mkdir -p "$R/private/var/root/Media/ios1kit" || fail make-log-dir
LOG="$R/private/var/root/Media/ios1kit/install.log"
say "==== ios1kit $MODE batch $BATCH ===="

FW=`fw_version`
say "Firmware: $FW"
case "$FW" in
	1.0|1.0.1) ;;
	*) fail "firmware-$FW-not-supported" ;;
esac

# --- 1. Free space, checked before anything on flash is modified.
if [ "$MODE" = "install" ]; then
	SYSFREE=`free_kb $R`
	VARFREE=`free_kb $R/private/var`
	[ -n "$SYSFREE" ] || fail "df-system-unreadable"
	[ -n "$VARFREE" ] || fail "df-data-unreadable"
	say "Free: system ${SYSFREE} KB (need ${NEED_SYS_KB}), data ${VARFREE} KB (need ${NEED_VAR_KB})"
	[ "$SYSFREE" -ge "$NEED_SYS_KB" ] || fail "system-partition-full"
	[ "$VARFREE" -ge "$NEED_VAR_KB" ] || fail "data-partition-full"
fi

# --- 2. Undo a half-finished iLiberty pass 2 (it parks SpringBoard and
#        CommCenter in / and only puts them back if pass 2 completes).
say "Repairing iLiberty leftovers..."
for d in com.apple.SpringBoard.plist com.apple.CommCenter.plist; do
	if [ -f "$R/$d" ]; then
		if [ -f "$R/System/Library/LaunchDaemons/$d" ]; then
			run "repair-$d" rm -f "$R/$d"
		else
			run "repair-$d" mv -f "$R/$d" "$R/System/Library/LaunchDaemons/$d"
			say "  restored $d"
		fi
	fi
	if [ -f "$R/System/Library/LaunchDaemons/$d" ]; then
		run "repair-$d" chown 0:0 "$R/System/Library/LaunchDaemons/$d"
		run "repair-$d" chmod 644 "$R/System/Library/LaunchDaemons/$d"
	fi
done
run repair-iliberty-daemon rm -f "$R/Library/LaunchDaemons/com.zjlotto.iLiberty.plist"
run repair-bin2 rm -rf "$R/bin2"
for m in "$R/private/var/root/Media" "$R/private/var/mobile/Media"; do
	if [ -d "$m" ]; then
		run repair-media rm -f "$m/payload.zip" "$m/iLiberty_Signature" "$m/PHONE2PC.msg"
		run repair-media rm -rf "$m/payload"
	fi
done
[ -f "$R/System/Library/LaunchDaemons/com.apple.SpringBoard.plist" ] || fail "springboard-plist-missing"

# --- 3. Writable system partition (what every 1.0 jailbreak did).
if [ ! -f "$R/private/etc/fstab.ios1kit-orig" ]; then
	run fstab-backup cp -p "$R/private/etc/fstab" "$R/private/etc/fstab.ios1kit-orig"
fi
echo "/dev/disk0s1 / hfs rw 0 1" > "$R/private/etc/fstab" || fail write-fstab
echo "/dev/disk0s2 /private/var hfs rw 0 2" >> "$R/private/etc/fstab" || fail write-fstab

# --- 4. Activation (patched lockdownd, fake factory activation).
if [ "$ACTIVATE" = "1" ]; then
	say "Activating $FW..."
	LD=Lockdownd10
	[ "$FW" = "1.0.1" ] && LD=Lockdownd101
	if [ ! -f "$R/usr/libexec/lockdownd.ios1kit-orig" ]; then
		run activate-backup cp -p "$R/usr/libexec/lockdownd" "$R/usr/libexec/lockdownd.ios1kit-orig"
	fi
	run activate-unzip unzip -o /payloads/activate/$LD.zip -d "$R/usr/libexec/"
	run activate-chown chown 0:0 "$R/usr/libexec/lockdownd"
	run activate-chmod chmod 555 "$R/usr/libexec/lockdownd"
	say "  done"
fi

# --- 5. Apps.
@PAYLOAD_STEPS@

# iPhone OS 1.0 has one home screen. Reserve visible slots for the launcher
# and Finder, which can open the apps that do not fit on SpringBoard.
if [ "$MODE" = "install" ] && [ -x "$R/Applications/Launcher.app/Launcher" ]; then
	say "Making Launcher visible on the home screen..."
	ORDER="$R/System/Library/CoreServices/SpringBoard.app/DisplayOrder.plist"
	PIN_IDS=com.nullriver.iphone.Launcher
	if [ -x "$R/Applications/Finder.app/Finder" ]; then
		PIN_IDS="$PIN_IDS,com.googlecode.MobileFinder"
	fi
	# The ramdisk root (including /tmp) is read-only. Stage beside the original
	# on the mounted system partition; leave the original untouched on failure.
	INPUT="$ORDER"
	HEADER=`awk 'NR==1 {printf "%s",substr($0,1,8); exit}' "$ORDER"` || fail home-screen-read
	if [ "$HEADER" = "bplist00" ]; then
		say "  Converting a copy of the binary layout..."
		run home-screen-copy cp -p "$ORDER" "$ORDER.ios1kit-xml"
		# Only this helper uses the phone's Foundation libraries. Its exit status
		# is insufficient: the strict editor below must also validate its output.
		DYLD_ROOT_PATH="$R" /bin/ios1kit-plutil -c xml1 "$ORDER.ios1kit-xml" >> "${LOG:-/dev/null}" 2>&1 || {
			rm -f "$ORDER.ios1kit-xml" "$ORDER.ios1kit-new"
			fail home-screen-convert
		}
		INPUT="$ORDER.ios1kit-xml"
	fi
	awk -v pins="$PIN_IDS" -f /etc/ios1kit-homescreen.awk "$INPUT" > "$ORDER.ios1kit-new" || {
		rm -f "$ORDER.ios1kit-new" "$ORDER.ios1kit-xml"
		fail home-screen-format
	}
	run home-screen-cleanup rm -f "$ORDER.ios1kit-xml"
	if [ ! -f "$ORDER.ios1kit-orig" ]; then
		run home-screen-backup cp -p "$ORDER" "$ORDER.ios1kit-orig"
	fi
	run home-screen-owner chown 0:0 "$ORDER.ios1kit-new"
	run home-screen-mode chmod 644 "$ORDER.ios1kit-new"
	run home-screen-replace mv -f "$ORDER.ios1kit-new" "$ORDER"
	say "  Launcher opens the installed apps; Finder is also available."
fi

# --- 6. Shared fix every 2007 toolchain binary needs.
run gcc-dirs mkdir -p "$R/usr/local/arm-apple-darwin/lib" "$R/usr/local/arm-apple-darwin/arm-apple-darwin/lib"
for l in "$R/usr/local/arm-apple-darwin/lib/libgcc_s.1.dylib" "$R/usr/local/arm-apple-darwin/arm-apple-darwin/lib/libgcc_s.1.dylib"; do
	if [ ! -e "$l" ]; then
		run gcc-link rm -f "$l"
		run gcc-link ln -s /usr/lib/libgcc_s.1.dylib "$l"
	fi
done

say "Flushing to flash..."
unmount_all || fail unmount
fsck_hfs -fn /dev/disk0s1 || fail fsck-system-after
fsck_hfs -fn /dev/disk0s2 || fail fsck-data-after

if [ "$MODE" = "repair" ]; then
	succeed "Repair complete. Booting iPhone OS..."
fi
succeed "Batch $BATCH done. The phone will now boot iPhone OS."
